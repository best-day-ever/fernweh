[Unit]
Description=PLANK remote broker (public API)
Documentation=file:///usr/local/share/doc/plank-broker/README.md
Wants=network-online.target plank-broker-relay.service
After=network-online.target plank-broker-relay.service

[Service]
Type=simple
User=plank-broker
Group=plank-broker
ExecStart=/usr/local/libexec/plank-broker/plank-broker --config /etc/plank-broker/broker.toml serve
Restart=on-failure
RestartSec=2s
# Sessions live in memory; a restart means every user signs in again.
StateDirectory=plank-broker
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=8192

# No privileges at all: the relay helper owns the firewall.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# INET for clients/KDC/LDAP/hosts, UNIX for the relay socket and journald,
# NETLINK for glibc getaddrinfo(AI_ADDRCONFIG) used by libkrb5.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
