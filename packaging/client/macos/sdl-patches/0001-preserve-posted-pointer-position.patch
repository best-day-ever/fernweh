+// PLANK posted-pointer policy begin. Local modification to SDL 3.4.2.
+// A process may post mouse input without moving the desktop's global cursor
+// (remote-control software and accessibility automation do this). Preserve the
+// event's position for those sources; physical events keep SDL's macOS 26
+// fullscreen Spaces workaround. This is coordinate selection, not trust.
+static bool Cocoa_GetPostedMousePosition(NSEvent *event, int windowHeight, float *x, float *y)
+{
+    CGEventRef quartzEvent = event.CGEvent;
+    if (!quartzEvent || CGEventGetIntegerValueField(quartzEvent, kCGEventSourceUnixProcessID) <= 0) {
+        return false;
+    }
+    const NSPoint point = event.locationInWindow;
+    *x = point.x;
+    *y = windowHeight - point.y;
+    return true;
+}
+// PLANK posted-pointer policy end.
