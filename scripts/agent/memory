#!/bin/bash
# Minimal MemPalace MCP client (JSON-RPC over the local tunnel on 127.0.0.1:8765).
# usage: scripts/agent/memory <tool> '<json-args>'      e.g. scripts/agent/memory mempalace_search '{"query":"flame dku"}'
set -euo pipefail
TOOL="${1:?tool}"; ARGS="${2:-{\}}"
curl -s --max-time 30 -X POST "${MEMPALACE_URL:-http://127.0.0.1:8765/mcp}" \
  -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
  -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"$TOOL\",\"arguments\":$ARGS}}" \
  | python3 -c 'import sys,json;d=json.load(sys.stdin);r=d.get("result") or d.get("error");print("".join(c.get("text","") for c in r.get("content",[])) if isinstance(r,dict) and "content" in r else json.dumps(r,indent=1))'
